# Apache .htaccess pentru site-live
# Maparea exactă a serverului de producție: servește site-live/ cu canonicalizare URL-uri

# Dezactivează liste de directoare și MultiViews
Options -Indexes -MultiViews
DirectorySlash Off

# Setează charset-ul implicit
AddDefaultCharset utf-8

# Activează mod_rewrite
RewriteEngine On

# Redirect .html → clean: folosește THE_REQUEST pentru a evita buclele de redirect (spec F0.3)
RewriteCond %{THE_REQUEST} \s/([^?\s]+)\.html[\s?] [NC]
RewriteRule ^(.*)$ /%1 [R=301,L]

# Redirect slash final (non-root) → fără slash: doar dacă nu e director real cu index
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^/(.+)/$ /$1 [R=301,L]

# Redirecturi externe pentru sloguri vechi (pentru F0.6)
RewriteRule ^joc/tetris$ /joc/blocuri [R=301,L]
RewriteRule ^joc/flappy$ /joc/aripi [R=301,L]

# Rescriere internă: servește fișiere .html când URL-urile vin fără extensie
# Folosește [END] și condiție !-f pentru a evita buclele (spec F0.3)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+)$ $1.html [END]